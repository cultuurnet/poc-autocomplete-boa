[mysqld]

# Type-ahead means matching 1-2 character prefixes in boolean mode. The default
# minimum token size of 3 would silently index nothing for "ge", so every short
# query would return an empty list.
innodb_ft_min_token_size = 1

# Same reason, for the MyISAM/global fulltext parser.
ft_min_word_len = 1

# The built-in stopword list is English. Dutch street names contain words that
# appear in it ("de", "in", "on"), and dropping them would lose real matches.
innodb_ft_enable_stopword = OFF

# The address-level import is 4.2M rows. With a small buffer pool the benchmark
# would be measuring disk I/O rather than the engine, which makes the
# MySQL-vs-Elasticsearch comparison meaningless.
innodb_buffer_pool_size = 1G

# The importer sends bulk multi-row INSERTs; the 64M default rejects them.
max_allowed_packet = 256M

# Belgian addresses carry accented characters; utf8mb4 with an accent- and
# case-insensitive collation is what the query layer assumes.
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# Imports are throwaway POC data: don't pay for a durable flush per commit.
innodb_flush_log_at_trx_commit = 2

[client]
default-character-set = utf8mb4
