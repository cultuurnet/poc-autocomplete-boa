# Reference for the environment variables src/Config.php reads.
#
# docker compose already injects these for the php container, so you do not
# need a .env file to run the stack. Copy this to .env only if you want to run
# bin/console straight from the host against the forwarded ports (use the
# "from the host" values noted below).

# Optional, and there is no default: without it every import needs --csv/-f
# (or `make import CSV=...`). Set it only to pin one file for this environment.
# The project root is mounted at /app, so any file under it works.
#CSV_PATH=/app/openaddress-bevlg.csv

MYSQL_HOST=mysql          # from the host: 127.0.0.1
MYSQL_PORT=3306           # from the host: 3307
MYSQL_DATABASE=autocomplete
MYSQL_USER=autocomplete
MYSQL_PASSWORD=autocomplete
MYSQL_TABLE=location_suggestions

ELASTICSEARCH_HOST=http://elasticsearch:9200   # from the host: http://127.0.0.1:9200
ELASTICSEARCH_INDEX=location_suggestions

# Whether the index holds house-number documents, i.e. whether it was built
# with --level=address or --level=all. On a street-level index (the import
# default) a typed house number cannot narrow the search, because no document
# carries one, so it is demoted to a ranking signal. Set this to 1 once the
# index carries house numbers and the number gates the search instead: on the
# 4.0M-document index "kerkstraat 12 gent" goes from 413 candidates to 2.
HOUSE_NUMBERS_INDEXED=0
