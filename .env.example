# Reference for the environment variables src/Config.php reads.
#
# docker compose already injects these for the php container, so you do not
# need a .env file to run the stack. Copy this to .env only if you want to run
# bin/console straight from the host against the forwarded ports (use the
# "from the host" values noted below).

# The 620 MB source file sits in the project root, mounted at /app.
CSV_PATH=/app/openaddress-bevlg.csv

MYSQL_HOST=mysql          # from the host: 127.0.0.1
MYSQL_PORT=3306           # from the host: 3307
MYSQL_DATABASE=autocomplete
MYSQL_USER=autocomplete
MYSQL_PASSWORD=autocomplete
MYSQL_TABLE=location_suggestions

ELASTICSEARCH_HOST=http://elasticsearch:9200   # from the host: http://127.0.0.1:9200
ELASTICSEARCH_INDEX=location_suggestions
